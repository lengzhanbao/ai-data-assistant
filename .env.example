# AI 数据分析助手 配置示例（复制为 .env 后按需填入）

# === Flask ===
# 生产环境必须配置；未配置且 FLASK_ENV=production 时启动失败
FLASK_SECRET=replace-me-with-a-long-random-secret
# development（默认）/ production
FLASK_ENV=development
# 是否启用 Flask 调试模式
FLASK_DEBUG=0
# 监听地址（生产建议 0.0.0.0，本地默认 127.0.0.1）
HOST=127.0.0.1
PORT=5000
# 生产环境（HTTPS）建议启用 1
COOKIE_SECURE=0

# === 上传限制 ===
# 单次上传最大字节（默认 25MB）
MAX_UPLOAD_BYTES=26214400

# === LLM（OpenAI-compatible） ===
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# === 沙箱（仅本机单用户演示） ===
# 沙箱执行超时（秒）
SANDBOX_TIMEOUT=20
# 注意：公网部署必须叠加容器 / OS 级隔离，不能仅靠本沙箱。
